#!/bin/bash
# 应用安装完成后：确认宿主机具备运行条件
# 本应用直接跑在宿主机上（不依赖 Docker），只需要 adb 与 python3。
# 缺失就在这里报出来，别等到用户点了图标才发现起不来。

LOG_FILE="${TRIM_PKGVAR}/install.log"

log_msg() {
    mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

write_user_error() {
    echo "$1" > "${TRIM_TEMP_LOGFILE}"
    log_msg "ERROR: $1"
}

log_msg "install_callback started. APPDEST=${TRIM_APPDEST}"

if ! command -v python3 >/dev/null 2>&1; then
    write_user_error "未找到 python3，无法启动服务。"
    exit 0
fi

if ! command -v adb >/dev/null 2>&1; then
    write_user_error "未找到 adb。请先在飞牛的终端里安装 Android 调试工具（apt install adb）后重试。"
    exit 0
fi

log_msg "python3: $(python3 -V 2>&1)"
log_msg "adb: $(command -v adb) ($(adb version 2>/dev/null | head -1))"
log_msg "install_callback done."

exit 0
